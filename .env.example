# FinGuard AI - Environment Configuration Example
# Copy this file to .env and adjust variables as required.
# Never commit actual production API keys or credentials to version control.

# Application Environment (development / production)
FINGUARD_ENV=development
FINGUARD_LOG_LEVEL=INFO

# Data Paths
FINGUARD_BENCHMARK_PATH=data/raw/creditcard.csv
FINGUARD_CASES_DB_PATH=data/cases.db

# Surveillance Default Parameters
FINGUARD_DEFAULT_THRESHOLD=0.65
FINGUARD_CONTAMINATION=0.0172
FINGUARD_MAX_BATCH_ROWS=50000

# Optional External Compliance LLM Integration (Disabled by default)
# When configured, used only for investigation assistant report synthesis
ENABLE_EXTERNAL_LLM=false
LLM_PROVIDER=none
LLM_API_KEY=your_api_key_placeholder
LLM_MODEL_NAME=gemini-1.5-flash

